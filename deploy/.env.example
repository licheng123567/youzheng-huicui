# 有证慧催 · 生产环境变量样板
#   cp deploy/.env.example deploy/.env && 填真值
#   deploy/.env 已在 .gitignore，切勿入库
#
# 少配任何一个「必填」项，后端会在启动时被 ProdGuard 拒绝（IllegalStateException），
# 而不是悄悄降级到 dev 口径。这是刻意设计。

# ── 后端镜像（必填）─────────────────────────────────────────────────
# 这一行就是你的「当前部署版本」。回退 = 改成上一个 tag，再 docker compose up -d backend。
# 可用 tag：v1.10.0 这类发布版本，或 sha-abc1234（每次 main 构建都有）。
# 镜像列表：https://github.com/licheng123567/youzheng-huicui/pkgs/container/huicui-backend
# 回退步骤见 deploy/ROLLBACK.md。
HUICUI_IMAGE_TAG=
# HUICUI_IMAGE=ghcr.io/licheng123567/huicui-backend   # 仅在换 registry 时才需要覆盖

# ── 数据库（必填）───────────────────────────────────────────────────
POSTGRES_DB=huicui
POSTGRES_USER=huicui
POSTGRES_PASSWORD=          # 强随机，勿用 test

# ── JWT（必填）──────────────────────────────────────────────────────
# 生成：openssl rand -base64 48
# 要求 ≥32 字节（HS256），且不得等于 dev 内置串
HUICUI_JWT_SECRET=

# ── 三方密钥主密钥（启用「后台配置三方 key」或「真 AI」时必填）──────────
# 后台维护的易保全/短信/百炼/DeepSeek 密钥用它 AES-256-GCM 加密落库。
# 不设：后台存任何 key 会得 409；且百炼/DeepSeek 无环境变量兜底 → 真 AI（录音转写+复盘）无法启用。
# 生成：openssl rand -base64 48
# ⚠ 一经落库切勿更换——换了库里所有旧密文都解不开（三方通道会静默失效）。
HUICUI_CRYPTO_KEY=

# ── 后端对外端口（可选，默认 9091）─────────────────────────────────
BACKEND_PORT=9091

# ── 短信（智讯云 028lk）────────────────────────────────────────────
# 置 true 后，下面四项必填，且 HUICUI_PUBLIC_BASE 必须是真实可达域名
# （它会被拼进发给业主的缴费链接 /pay/{token}；localhost 会被 ProdGuard 拒绝）。
HUICUI_SMS_ENABLED=false
# dry-run：走完整条业务链路（冷却/sms_record/pay-link 状态机）但不触网关、不产生费用。
# 仅供预发演练；prod 开启时 ProdGuard 会打刺眼 WARN。会把验证码写进日志，正式生产必须 false。
HUICUI_SMS_DRY_RUN=false
HUICUI_PUBLIC_BASE=https://your-domain.example.com
HUICUI_SMS_SECRET_NAME=
HUICUI_SMS_SECRET_KEY=
HUICUI_SMS_BASE=            # 普通短信接口地址，向对接方索取
HUICUI_SMS_SIGN=【有证慧催】
HUICUI_SMS_TPL_VERIFY=      # 验证码模板 id（空=用明文 Content，需已报备）
HUICUI_SMS_TPL_PAYLINK=     # 缴费链接模板 id

# ── 存证（易保全）──────────────────────────────────────────────────
# 置 true 后 appKey/secret 必填，且 URL 不能再是 sandbox
# （沙箱出的证书没有法律效力，ProdGuard 会拒绝启动）。
HUICUI_EBQ_ENABLED=false
HUICUI_EBQ_URL=https://bs.sandbox.ebaoquan.org
HUICUI_EBQ_APPKEY=
HUICUI_EBQ_SECRET=
