# 有证慧催 · 生产环境变量样板
#   cp deploy/.env.example deploy/.env && 填真值
#   deploy/.env 已在 .gitignore，切勿入库
#
# 少配任何一个「必填」项，后端会在启动时被 ProdGuard 拒绝（IllegalStateException），
# 而不是悄悄降级到 dev 口径。这是刻意设计。

# ── 后端镜像（必填）─────────────────────────────────────────────────
# 这一行就是你的「当前部署版本」。回退 = 改成上一个 tag，再 docker compose up -d backend。
# 可用 tag：v1.10.0 这类发布版本，或 sha-abc1234（每次 main 构建都有）。
# 镜像列表：https://github.com/licheng123567/youzheng-huicui/pkgs/container/huicui-backend
# 回退步骤见 deploy/ROLLBACK.md。
HUICUI_IMAGE_TAG=
# HUICUI_IMAGE=ghcr.io/licheng123567/huicui-backend   # 仅在换 registry 时才需要覆盖

# ── 数据库（必填）───────────────────────────────────────────────────
POSTGRES_DB=huicui
POSTGRES_USER=huicui
POSTGRES_PASSWORD=          # 强随机，勿用 test

# ── JWT（必填）──────────────────────────────────────────────────────
# 生成：openssl rand -base64 48
# 要求 ≥32 字节（HS256），且不得等于 dev 内置串
HUICUI_JWT_SECRET=

# ── 加密主密钥（必填）───────────────────────────────────────────────
# 三方通道密钥（易保全/短信/百炼 ASR/DeepSeek）AES-256-GCM 落库时用它加密。
# 不配 → 后台点「保存密钥」恒 409，且 ASR/LLM 只有落库这一条路 = 真 AI 永远用不了。
# 生成：openssl rand -base64 32
# ⚠️ 换掉这个 key 会导致已落库的密文全部解不开，需要在后台重新填一遍三方密钥。
HUICUI_CRYPTO_KEY=

# ── 域名（必填）─────────────────────────────────────────────────────
# nginx 用它签发/加载证书并做 server_name 匹配。必须是**已解析到本机公网 IP** 的真实域名，
# 否则 Let's Encrypt 签不出证书。
HUICUI_DOMAIN=huicui.example.com

# ── 初始管理员引导（仅首次部署）─────────────────────────────────────
# 生产库是空的：没有公开注册、没有种子账号。不填这三项，部署完**没有任何人能登录**。
# 只在 account 表为空时生效；已有账号则自动跳过（重复启动安全）。
# 建出来的超管 must_change_password=TRUE —— 首次登录强制改密，下面这个口令改完即作废。
# 改密成功后，把这三行从 .env 里删掉。
# 生成口令：openssl rand -base64 18   （要求 ≥12 位，太短会拒绝启动）
HUICUI_BOOTSTRAP_ADMIN_USERNAME=
HUICUI_BOOTSTRAP_ADMIN_PASSWORD=
HUICUI_BOOTSTRAP_ADMIN_PHONE=

# ── 上传限额（可选）─────────────────────────────────────────────────
# 录音是 multipart 大文件。Spring 默认只有 1MB —— 不设这两项，真实通话录音必然 500。
# 改大时记得同步改 deploy/nginx.conf 的 client_max_body_size。
HUICUI_MAX_FILE_SIZE=200MB
HUICUI_MAX_REQUEST_SIZE=220MB

# ── JWT 有效期（可选，默认 86400 秒 = 24h）──────────────────────────
HUICUI_JWT_TTL=86400

# ── 短信（智讯云 028lk）────────────────────────────────────────────
# 置 true 后，下面四项必填，且 HUICUI_PUBLIC_BASE 必须是真实可达域名
# （它会被拼进发给业主的缴费链接 /pay/{token}；localhost 会被 ProdGuard 拒绝）。
HUICUI_SMS_ENABLED=false
# dry-run：走完整条业务链路（冷却/sms_record/pay-link 状态机）但不触网关、不产生费用。
# 仅供预发演练；prod 开启时 ProdGuard 会打刺眼 WARN。会把验证码写进日志，正式生产必须 false。
HUICUI_SMS_DRY_RUN=false
HUICUI_PUBLIC_BASE=https://your-domain.example.com
HUICUI_SMS_SECRET_NAME=
HUICUI_SMS_SECRET_KEY=
HUICUI_SMS_BASE=            # 普通短信接口地址，向对接方索取
HUICUI_SMS_SIGN=【有证慧催】
HUICUI_SMS_TPL_VERIFY=      # 验证码模板 id（空=用明文 Content，需已报备）
HUICUI_SMS_TPL_PAYLINK=     # 缴费链接模板 id

# ── 存证（易保全）──────────────────────────────────────────────────
# 置 true 后 appKey/secret 必填，且 URL 不能再是 sandbox
# （沙箱出的证书没有法律效力，ProdGuard 会拒绝启动）。
HUICUI_EBQ_ENABLED=false
HUICUI_EBQ_URL=https://bs.sandbox.ebaoquan.org
HUICUI_EBQ_APPKEY=
HUICUI_EBQ_SECRET=

# ── 备份加密与异地（生产必配）─────────────────────────────────────
# 库里是业主真实姓名/电话/住址/欠费金额/通话录音。backup.sh 默认**拒绝**产出明文备份。
#
# 公钥放服务器（只能加密），私钥**离线保管**（密码管理器/另一台机器）——
# 服务器被拖库也解不开备份。用口令做对称加密是没用的：口令就在这台机器的 .env 里。
#   openssl genrsa -out huicui-backup-private.pem 4096   # ← 离线保管，绝不上服务器
#   openssl rsa -in huicui-backup-private.pem -pubout -out huicui-backup-public.pem
#   scp huicui-backup-public.pem <服务器>:/opt/huicui/deploy/backup-public.pem
BACKUP_PUBLIC_KEY=deploy/backup-public.pem

# 异地：不绑定云厂商，{} 会被替换成文件路径。不配 = 备份与数据库同一块盘，一起坏、一起被拖走。
#   BACKUP_UPLOAD_CMD='aws s3 cp {} s3://my-bucket/huicui/'
#   BACKUP_UPLOAD_CMD='ossutil cp {} oss://my-bucket/huicui/'
BACKUP_UPLOAD_CMD=

BACKUP_RETAIN_DAYS=14

# ── 监控告警（生产必配）─────────────────────────────────────────────
# 不配 = 服务挂了、证书过期了、备份三天没成功了，你只能等客户打电话来告诉你。
# 按域名自动识别钉钉/企业微信/飞书/Slack；认不出来就发通用 JSON。
#   HUICUI_ALERT_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
#   HUICUI_ALERT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
HUICUI_ALERT_WEBHOOK=

# 告警去重：持续故障每 N 小时复读一次（每 5 分钟巡检一次，若每次都发，一晚上 288 条 = 没人会看）
HUICUI_ALERT_REPEAT_HOURS=6

# 阈值（一般不用改）
HUICUI_DISK_WARN_PCT=80
HUICUI_DISK_CRIT_PCT=90
HUICUI_BACKUP_MAX_AGE_HOURS=26     # 日备 + 2h 宽限；超过就是「日备断了」
HUICUI_CERT_WARN_DAYS=20           # 证书正常应在 30 天前自动续上
HUICUI_CERT_CRIT_DAYS=7

# ── 对象存储（录音/附件）─────────────────────────────────────────────
# 默认 pg = 录音/附件仍以 bytea 存在库里。录音是 8k 通话音频，一个批次几千通电话就能把库撑到几十 GB，
# 拖累的是备份体积、恢复时长、连接池占用（回听一次要把整段音频读进 JVM，池子只有 10 条连接）。
#
# 切到 s3 后：新录音进桶、库里只留 key；**存量录音仍在 bytea，读路径会自动回落**——切换当天不会读丢。
# AWS S3 / 阿里云 OSS / MinIO 走同一套 API，只有 endpoint 与 path-style 不同。
#
# ⚠️ 开了 s3 却没配全（缺 key/bucket）会**拒绝启动**，而不是悄悄回落到 bytea ——
#    「以为切了对象存储、其实还在往库里塞」，你会在库涨到几十 GB 时才发现。
HUICUI_STORAGE_TYPE=pg
HUICUI_S3_ENDPOINT=          # 阿里云 OSS: https://oss-cn-chengdu.aliyuncs.com
HUICUI_S3_REGION=cn-north-1
HUICUI_S3_ACCESS_KEY=
HUICUI_S3_SECRET_KEY=
HUICUI_S3_BUCKET=
HUICUI_S3_PATH_STYLE=true    # 阿里云 OSS 要 false（virtual-host 风格）；MinIO 要 true
